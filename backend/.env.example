# 쿠피 백엔드 환경변수 예시. 이 파일을 .env로 복사해 값을 채운다.
# .env는 커밋하지 않는다 (.gitignore). prod 값은 GCP Secret Manager에서 주입한다.

NODE_ENV=development
PORT=8080

# --- 데이터베이스 -------------------------------------------------------------
# dev는 Neon(무료 서버리스 Postgres), prod는 Cloud SQL을 쓴다 (docs/10-기술스택결정.md).
#
# Neon은 엔드포인트가 두 개다. 둘 다 콘솔의 Connection Details에서 복사한다.
#   DATABASE_URL        — 풀링(-pooler가 붙은 호스트). 런타임용
#   DIRECT_DATABASE_URL — 직접 연결(-pooler 없음). prisma migrate용
# pgbouncer를 거치면 마이그레이션이 쓰는 세션 수준 기능이 동작하지 않아 둘을 나눈다.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/coupi?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/coupi?sslmode=require

# --- GCP 공통 ----------------------------------------------------------------
GCP_PROJECT_ID=coupi-dev
GCP_LOCATION=asia-northeast3

# --- Pub/Sub (docs/05-백엔드아키텍처.md) --------------------------------------
PUBSUB_TOPIC_MAIL_INGEST=mail-ingest
PUBSUB_TOPIC_COUPON_CLASSIFY=coupon-classify
# Gmail watch 알림이 발행되는 토픽 (users.watch에 지정하는 대상)
PUBSUB_TOPIC_GMAIL_NOTIFICATIONS=gmail-notifications

# Pub/Sub push 요청의 OIDC 토큰 검증 (docs/05 "내부 엔드포인트 보호").
# 운영에서는 PUBSUB_PUSH_SA_EMAIL이 필수다 — 없으면 부팅이 실패한다.
# 로컬에서는 비워두면 검증을 건너뛴다.
# PUBSUB_PUSH_SA_EMAIL=coupi-pubsub-invoker@coupi-dev.iam.gserviceaccount.com
# PUBSUB_PUSH_AUDIENCE=https://coupi-worker-dev-xxxx.run.app
# 로컬 개발 시 에뮬레이터 사용. 주석을 풀면 실제 GCP 대신 에뮬레이터로 붙는다.
# PUBSUB_EMULATOR_HOST=localhost:8085

# --- Cloud Tasks -------------------------------------------------------------
CLOUD_TASKS_QUEUE_PUSH_DISPATCH=push-dispatch
CLOUD_TASKS_QUEUE_EXPIRY_REMINDER=coupon-expiry-reminder
# Cloud Tasks가 호출할 워커 서비스 주소. 로컬에서는 자기 자신을 가리킨다.
WORKER_BASE_URL=http://localhost:8080

# --- Gmail OAuth -------------------------------------------------------------
# 환경별로 다른 클라이언트 ID를 쓴다 (docs/05 "환경 분리").
# 값은 GCP 콘솔에서 OAuth 클라이언트를 만든 뒤 사용자가 직접 채운다.
GMAIL_OAUTH_CLIENT_ID=changeme.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=changeme
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8080/auth/gmail/callback

# --- 암호화 / 세션 -----------------------------------------------------------
# AES-256-GCM 마스터 키 (base64, 32바이트). 생성: openssl rand -base64 32
# prod에서는 Secret Manager + Cloud KMS envelope encryption을 사용한다 (docs/07).
ENCRYPTION_MASTER_KEY=changeme-base64-32-bytes
# 설정되면 마스터 키 대신 Cloud KMS로 DEK를 감싼다 (운영 경로 — Terraform이 주입).
# KMS_KEY_NAME=projects/coupi-dev/locations/asia-northeast3/keyRings/coupi-dev/cryptoKeys/token-encryption
SESSION_JWT_SECRET=changeme-local-only

# --- 관측 --------------------------------------------------------------------
# SENTRY_DSN=

# prod(Cloud SQL)에서는 커넥터 소켓 경로를 쓰고, 풀링 엔드포인트가 없으므로
# DIRECT_DATABASE_URL에 같은 값을 넣는다:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost/coupi?host=/cloudsql/PROJECT:REGION:INSTANCE
