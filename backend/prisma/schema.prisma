// 쿠피(Coupi) 데이터 모델
//
// 기준 정의는 `docs/03-API-DB-스펙.md`의 DDL이다. 이 파일은 그 DDL과 1:1로 대응하도록
// 작성한다. Prisma 스키마로 표현할 수 없는 두 가지는 마이그레이션 SQL에 직접 넣는다:
//   1. CHECK 제약 (provider, status, filter_result, extractor_type, platform 등)
//   2. 부분 인덱스 (WHERE 절이 붙은 인덱스)
// 자세한 내용은 `prisma/README.md` 참고.
//
// 규칙 필터 테이블(filter_domains, filter_keywords)의 기준 정의는 `docs/02-쿠폰판별로직.md`에 있다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String   @unique @db.VarChar(255)
  notificationsEnabled Boolean? @default(true) @map("notifications_enabled")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  mailAccounts  MailAccount[]
  coupons       Coupon[]
  devices       Device[]
  filterDomains FilterDomain[]

  @@map("users")
}

model MailAccount {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  /// CHECK (provider IN ('gmail')) — 현재는 gmail 단일 값
  provider              String    @default("gmail") @db.VarChar(20)
  providerAccountEmail  String    @map("provider_account_email") @db.VarChar(255)
  /// AES-256-GCM, KMS 관리 키로 암호화 (docs/07-보안개인정보.md)
  encryptedRefreshToken String    @map("encrypted_refresh_token")
  encryptedAccessToken  String?   @map("encrypted_access_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  /// { historyId }
  cursor                Json?     @default("{}")
  /// CHECK (status IN ('active','reauth_required','auth_failed','revoked'))
  status                String?   @default("active") @db.VarChar(20)
  consecutiveFailures   Int?      @default(0) @map("consecutive_failures") @db.SmallInt
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  processedMails ProcessedMail[]

  @@unique([userId, provider, providerAccountEmail])
  @@map("mail_accounts")
}

model ProcessedMail {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mailAccountId     String   @map("mail_account_id") @db.Uuid
  providerMessageId String   @map("provider_message_id") @db.VarChar(255)
  sender            String   @db.VarChar(255)
  /// RFC 5322 제목 길이 제한
  subject           String?  @db.VarChar(998)
  receivedAt        DateTime @map("received_at") @db.Timestamptz(6)
  /// CHECK (filter_result IN ('passed','filtered_out','extraction_failed'))
  filterResult      String   @map("filter_result") @db.VarChar(20)
  processedAt       DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  mailAccount MailAccount @relation(fields: [mailAccountId], references: [id], onDelete: Cascade)
  coupons     Coupon[]

  /// 중복 처리 방지 핵심 제약 — Pub/Sub at-least-once 대응 (docs/08)
  @@unique([mailAccountId, providerMessageId])
  @@index([mailAccountId, receivedAt(sort: Desc)], map: "idx_processed_mails_account_date")
  @@map("processed_mails")
}

model Coupon {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  processedMailId String    @map("processed_mail_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  discount        String?   @db.VarChar(100)
  expiryDate      DateTime? @map("expiry_date") @db.Date
  conditions      String?
  /// 예: 'coupang_v1', 'generic_v1' — 어떤 파서가 추출했는지 (신뢰도의 대리 지표)
  extractorId     String    @map("extractor_id") @db.VarChar(50)
  /// CHECK (extractor_type IN ('sender_specific','generic_regex','llm')) — 'llm'은 향후 확장용
  extractorType   String    @map("extractor_type") @db.VarChar(20)
  usableNow       Boolean   @map("usable_now")
  /// CHECK (status IN ('active','expired','used','dismissed'))
  status          String?   @default("active") @db.VarChar(20)
  /// 3단계 베타에서 활성화 (docs/00 결정 #3) — MVP는 컬럼만 선반영
  usedAt          DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  processedMail ProcessedMail  @relation(fields: [processedMailId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([userId, status, expiryDate], map: "idx_coupons_user_status")
  @@map("coupons")
}

model Device {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  fcmToken     String   @map("fcm_token") @db.VarChar(500)
  /// CHECK (platform IN ('ios','android'))
  platform     String   @db.VarChar(10)
  lastActiveAt DateTime @default(now()) @map("last_active_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([userId, fcmToken])
  @@map("devices")
}

model Notification {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId         String?   @map("coupon_id") @db.Uuid
  deviceId         String?   @map("device_id") @db.Uuid
  /// CHECK (notification_type IN ('new_coupon','expiry_reminder'))
  notificationType String?   @default("new_coupon") @map("notification_type") @db.VarChar(20)
  /// CHECK (send_status IN ('pending','sent','failed','skipped_disabled'))
  sendStatus       String?   @default("pending") @map("send_status") @db.VarChar(20)
  retryCount       Int?      @default(0) @map("retry_count") @db.SmallInt
  sentAt           DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

/// 규칙 필터 — 기준 정의는 docs/02-쿠폰판별로직.md
model FilterDomain {
  id        Int      @id @default(autoincrement())
  domain    String   @db.VarChar(255)
  isGlobal  Boolean? @default(true) @map("is_global")
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id])

  @@map("filter_domains")
}

model FilterKeyword {
  id        Int      @id @default(autoincrement())
  keyword   String   @db.VarChar(100)
  lang      String?  @default("ko") @db.VarChar(10)
  weight    Int?     @default(1) @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("filter_keywords")
}
